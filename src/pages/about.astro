---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="关于我 — APPLEpig's Blog" description="关于 APPLEpig (msmlwdzh) 的个人介绍">
  <Navbar />

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="text-3xl font-extrabold mb-1">关于我</h1>
    <svg class="title-underline mb-8" viewBox="0 0 320 14" preserveAspectRatio="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <path d="M2 9 Q 80 2 160 7 T 312 6" style="stroke:var(--color-gold);stroke-width:2;fill:none;stroke-linecap:round;opacity:0.75" />
      <circle cx="312" cy="6" r="2.6" style="fill:var(--color-accent-alt)" />
    </svg>

    <!-- Profile — no card wrapper, just spacing and typography -->
    <div class="flex items-center gap-4 mb-8">
      <img
        src="https://avatars.githubusercontent.com/u/221705216?v=4"
        alt="APPLEpig"
        class="w-14 h-14 rounded-full"
      />
      <div>
        <h2 class="text-xl font-bold">APPLEpig</h2>
        <p class="text-muted text-sm">
          GitHub: <a href="https://github.com/msmlwdzh" class="text-accent hover:underline underline-offset-2" target="_blank" rel="noopener">msmlwdzh</a> · 📍 中国
        </p>
      </div>
    </div>

    <div class="space-y-8 text-muted leading-relaxed">
      <p>
        你好！我是 <span class="text-accent">APPLEpig</span>，一名来自中国的开发者。
        我对技术充满热情，喜欢探索前沿的开发技术和工具。
      </p>

      <!-- Tech stack — tags only, no card -->
      <div>
        <h2 class="text-lg font-bold mb-3 pb-2 border-b border-border">技术栈</h2>
        <div class="flex flex-wrap gap-2">
          <span class="px-2.5 py-0.5 text-xs text-accent border border-border rounded">JavaScript</span>
          <span class="px-2.5 py-0.5 text-xs text-accent border border-border rounded">SCSS</span>
          <span class="px-2.5 py-0.5 text-xs text-accent border border-border rounded">Astro</span>
          <span class="px-2.5 py-0.5 text-xs text-accent border border-border rounded">Tailwind CSS</span>
          <span class="px-2.5 py-0.5 text-xs text-accent border border-border rounded">TypeScript</span>
          <span class="px-2.5 py-0.5 text-xs text-accent border border-border rounded">Node.js</span>
        </div>
      </div>

      <!-- Projects — list with dividers, not cards -->
      <div>
        <h2 class="text-lg font-bold mb-3 pb-2 border-b border-border">项目</h2>
        <div class="divide-y divide-border">
          <a href="https://github.com/msmlwdzh/msmlwdzh.github.io" target="_blank" rel="noopener"
             class="block py-3 group hover:bg-surface -mx-3 px-3 transition-smooth">
            <h3 class="text-sm font-semibold group-hover:text-accent transition-smooth">msmlwdzh.github.io</h3>
            <p class="text-xs text-muted/60 mt-0.5">个人 GitHub Pages 站点 · SCSS</p>
          </a>
          <a href="https://github.com/msmlwdzh/checkin" target="_blank" rel="noopener"
             class="block py-3 group hover:bg-surface -mx-3 px-3 transition-smooth">
            <h3 class="text-sm font-semibold group-hover:text-accent transition-smooth">checkin</h3>
            <p class="text-xs text-muted/60 mt-0.5">签到项目 · JavaScript</p>
          </a>
        </div>
      </div>

      <!-- About this blog — plain text, no card -->
      <div>
        <h2 class="text-lg font-bold mb-3 pb-2 border-b border-border">关于这个博客</h2>
        <p>
          本博客使用 <span class="text-accent">Astro</span> 构建并搭配
          <span class="text-accent">Tailwind CSS v4</span> 样式。
        </p>
        <p>
          内容采用 Markdown 文件驱动，通过 Git 版本控制，构建时编译为纯静态 HTML，默认零 JavaScript 输出。
        </p>
      </div>

      <div class="pt-2">
        <a href="https://github.com/msmlwdzh" target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 text-accent hover:underline underline-offset-2 text-sm">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          在 GitHub 上找到我
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
