---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <Navbar />

  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-10 pb-6 border-b border-border">
      <h1 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight mb-2">{post.data.title}</h1>
      <svg class="title-underline" viewBox="0 0 320 14" preserveAspectRatio="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 9 Q 80 2 160 7 T 312 6" style="stroke:var(--color-gold);stroke-width:2;fill:none;stroke-linecap:round;opacity:0.7" />
        <circle cx="312" cy="6" r="2.6" style="fill:var(--color-accent-alt)" />
      </svg>
      <div class="flex items-center gap-3 text-muted text-sm">
        <time>
          {post.data.date.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {post.data.tags.length > 0 && (
          <div class="flex gap-1.5">
            {post.data.tags.map((tag: string) => (
              <span class="px-2 py-0.5 text-xs text-accent/70 border border-border rounded">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="prose max-w-none">
      <Content />
    </div>

    <a href="/" class="inline-block mt-10 text-accent hover:underline underline-offset-2 text-sm">
      &larr; 返回首页
    </a>
  </article>

  <Footer />
</Layout>
