---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="APPLEpig's Blog">
  <Navbar />

  <main class="max-w-5xl mx-auto px-4 sm:px-6">
    <!-- Hero — 咖啡 × 太空 -->
    <section class="relative pt-20 pb-16 sm:pt-28 sm:pb-24 overflow-hidden">
      <!-- 装饰：星辰 + 轨道环（同时呼应咖啡渍） -->
      <div class="starfield" aria-hidden="true"></div>
      <div class="orbit-ring hidden sm:block" style="width:380px;height:380px;right:-70px;top:0;" aria-hidden="true"></div>
      <div class="orbit-ring orbit-ring--alt hidden sm:block" style="width:260px;height:260px;right:30px;top:60px;" aria-hidden="true"></div>

      <div class="relative">
        <h1
          class="font-display text-5xl sm:text-7xl font-extrabold tracking-tight mb-1"
          style="font-variation-settings: 'opsz' 144;"
        >
          APPLEpig<svg class="planet-mark" viewBox="0 0 36 36" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <ellipse cx="18" cy="18" rx="17" ry="5.5" transform="rotate(-22 18 18)" style="stroke:var(--color-gold);stroke-width:2.2;fill:none" />
            <circle cx="18" cy="18" r="7.5" style="fill:var(--color-accent)" />
            <ellipse cx="15.3" cy="15.3" rx="2.6" ry="1.6" style="fill:var(--color-gold);opacity:0.65" />
          </svg>
        </h1>
        <!-- 手绘金色波浪下划线，收尾小行星 -->
        <svg class="title-underline" viewBox="0 0 320 14" preserveAspectRatio="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 9 Q 80 2 160 7 T 312 6" style="stroke:var(--color-gold);stroke-width:2;fill:none;stroke-linecap:round;opacity:0.75" />
          <circle cx="312" cy="6" r="2.6" style="fill:var(--color-accent-alt)" />
        </svg>

        <p class="text-muted text-base sm:text-lg leading-relaxed max-w-xl mb-8 mt-5">
          来自中国的开发者。在这里记录技术思考、项目实践与灵感 —— 一杯咖啡的功夫，漫游代码与星辰。
        </p>
        <div class="flex gap-3">
          <Button variant="primary" href="/blog">阅读博客</Button>
          <Button variant="secondary" href="/about">关于我</Button>
        </div>
      </div>
    </section>

    <!-- Latest Posts — list layout with dividers, no card grid -->
    <section class="pb-20">
      <h2 class="text-xl font-bold mb-6 pb-3 border-b border-border flex items-center gap-2">
        最新文章
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 1 L9.2 6.2 L14.5 7 L9.2 7.8 L8 13 L6.8 7.8 L1.5 7 L6.8 6.2 Z" style="fill:var(--color-gold);opacity:0.8" />
        </svg>
      </h2>
      <div class="divide-y divide-border">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="block py-5 group hover:bg-surface -mx-3 px-3 transition-smooth">
            <h3 class="text-base font-semibold mb-1 group-hover:text-accent transition-smooth">{post.data.title}</h3>
            {post.data.description && <p class="text-muted text-sm leading-relaxed mb-2">{post.data.description}</p>}
            <time class="text-xs text-muted/60">
              {post.data.date.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
