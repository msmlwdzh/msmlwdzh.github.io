---
interface Props {
  title?: string;
  description?: string;
}

const { title = "APPLEpig's Blog", description = "A minimal dark-mode blog by APPLEpig (msmlwdzh) — technical thoughts, projects, and ideas." } = Astro.props;
import '../styles/globals.css';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description} />
    <meta name="author" content="APPLEpig (msmlwdzh)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="APPLEpig's Blog" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-bg text-text">
    <slot />
  </body>
</html>