---
interface Props {
  variant?: 'primary' | 'secondary' | 'accent';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  children: Astro.Children;
}

const { variant = 'primary', size = 'md', href = '#', children } = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium rounded-lg transition-smooth focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-bg disabled:opacity-50';

const variants = {
  primary: 'bg-accent text-bg hover:bg-opacity-90',
  secondary: 'border border-border hover:bg-surface',
  accent: 'bg-accent-alt text-bg hover:bg-opacity-90',
};

const sizes = {
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-4 py-2 text-base',
  lg: 'px-6 py-3 text-lg',
};
---

<a
  href={href}
  class="{baseStyles} {variants[variant]} {sizes[size]}"
  transition-smooth
>
  {children}
</a>