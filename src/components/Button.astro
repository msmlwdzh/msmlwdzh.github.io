---
interface Props {
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md';
  href?: string;
  children: Astro.Children;
}

const { variant = 'primary', size = 'md', href = '#', children } = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium rounded transition-smooth focus:outline-none focus:ring-2 focus:ring-accent/30 focus:ring-offset-2 focus:ring-offset-bg';

const variants = {
  primary: 'bg-accent text-bg hover:opacity-90 shadow-sm',
  secondary: 'border border-accent-alt/40 text-accent-alt hover:bg-accent-alt/10 hover:border-accent-alt',
};

const sizes = {
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-4 py-2 text-sm',
};
---

<a
  href={href}
  class={`${baseStyles} ${variants[variant]} ${sizes[size]}`}
>
  {children}
</a>
