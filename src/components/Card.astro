---
interface Props {
  children: Astro.Children;
  title?: string;
}

const { children, title } = Astro.props;
---

<article class="surface-card p-5">
  {title && <h3 class="text-lg font-semibold mb-2">{title}</h3>}
  <div class="text-muted text-sm leading-relaxed">
    {children}
  </div>
</article>
